# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=business_search
POSTGRES_PORT=5432

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Business Search API"
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google OAuth settings for People API (Contacts)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/google/auth/callback

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Chrome Configuration
# Path to store Chrome profiles. For Linux, use /opt/chrome-profiles
# Make sure the directory has correct permissions (755) and is owned by the service user
CHROME_PROFILES_DIR=/opt/chrome-profiles